# Yakyard on your own server. Copy this file to .env, fill in the first two lines, then: docker compose up -d
# Never commit .env. Every setting is explained in docs/DOCKER.md and in the README, "All settings".

# The address your team will open, with no https://. Point its DNS at this server first.
DOMAIN=chat.example.com
# The code for the setup page, at least 24 characters. Make one with: openssl rand -hex 24
SETUP_TOKEN=

# Your team or company name, shown on the sign-in page.
WORKSPACE_NAME=Yakyard

# Voice note transcripts. Whisper runs on Cloudflare Workers AI, so this needs a free Cloudflare account:
# your account ID and a Workers AI API token (docs/DOCKER.md shows where). Leave both empty and voice notes
# still work, without transcripts.
CF_ACCOUNT_ID=
CF_API_TOKEN=
VOICE_LANGUAGE=en
VOICE_HINT=

# File space. The defaults fit Cloudflare's free plan; on your own server, size them to your disk.
STORAGE_PER_PERSON_GB=2
STORAGE_TOTAL_GB=9

# Optional, same as on Cloudflare (see the README):
# OWNER_EMAILS=
# ALLOWED_DOMAINS=
# VAPID_PUBLIC=
# VAPID_PRIVATE=
# VAPID_SUBJECT=
# GOOGLE_ENABLED=0
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_TEAM_ID=
# TOKEN_KEY=
# TURN_KEY_ID=
# TURN_KEY_TOKEN=
# TEAM_LOCATION=0
# WEATHER=0
# IMG_CACHE_MB=200

# Which image to run. "latest" follows releases; pin a release like 2.2.0 to update only when you choose.
# YAKYARD_VERSION=latest
