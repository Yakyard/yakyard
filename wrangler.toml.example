# Yakyard settings. `npm run deploy` copies this file to wrangler.toml the first time; edit wrangler.toml after that.
# Works as it is, on Cloudflare's free plan. Every setting is explained in the README, "All settings".
name = "yakyard"
main = "src/worker.js"
compatibility_date = "2026-11-01"
workers_dev = true

[assets]
directory = "public"
binding = "ASSETS"
run_worker_first = true

[[d1_databases]]
binding = "DB"
database_name = "yakyard"
# No database_id: the first `npm run deploy` creates the database and writes its id here.

[[r2_buckets]]
binding = "FILES"
bucket_name = "yakyard-files"

[[durable_objects.bindings]]
name = "HUB"
class_name = "Hub"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["Hub"]

# Image resizing for photo previews (Cloudflare Images binding).
[images]
binding = "IMAGES"

# Voice note transcripts (Whisper on Workers AI).
[ai]
binding = "AI"

# Free plan limits: see README, "Free plan". Optional storage caps (defaults shown):
# STORAGE_PER_PERSON_GB = "2"   STORAGE_TOTAL_GB = "9"   (R2 is free up to 10 GB)

# Every minute: reminders, scheduled messages, voice transcripts that need a retry, Slack imports.
[triggers]
crons = ["* * * * *"]

[vars]
WORKSPACE_NAME = "Yakyard"                      # your team or company name, shown on the sign-in page
APP_URL = ""                                    # optional: your Yakyard address, used in reminder links
OWNER_EMAILS = ""                               # optional, comma-separated: these emails are always owners
ALLOWED_DOMAINS = ""                            # e.g. "example.com": anyone with that email can sign in with Google
VAPID_PUBLIC = ""                               # phone notifications: see README, "Notifications"
VAPID_SUBJECT = ""                              # mailto: address push services can contact
VOICE_LANGUAGE = "en"                           # transcript language (ISO code)
VOICE_HINT = ""                                 # names and words Whisper should spell right, e.g. "Acme, Zoe, SKU"
GOOGLE_CLIENT_ID = ""                           # optional "Sign in with Google"
GOOGLE_ENABLED = "0"
SLACK_CLIENT_ID = ""                            # optional Slack import
SLACK_TEAM_ID = ""                              # needed for the Slack import: your Slack workspace id (starts with T)
DEV_LOGIN = "0"                                 # local testing only: "1" lets /auth/dev?email=... sign in on localhost
TEAM_LOCATION = "0"                             # "1" turns on team clocks: people can choose to share their city and local time
WEATHER = "0"                                   # "1" adds weather to team clocks (Open-Meteo, free for non-commercial use only)
# SLACK_API = "https://slack.com/api"           # only for tests: point the Slack import at a mock server

# Secrets (set with `npx wrangler secret put NAME`, never put them in this file):
#   SETUP_TOKEN           made for you by the first `npm run deploy` and printed once: the code for the setup page
#   VAPID_PRIVATE         phone notifications (npm run vapid prints it)
#   TOKEN_KEY             only with the Slack import: encrypts Slack tokens during the import: base64 of 32 random bytes, make it with `openssl rand -base64 32`
#   GOOGLE_CLIENT_SECRET  only with Google sign-in
#   SLACK_CLIENT_SECRET   only with the Slack import
#   TURN_KEY_ID, TURN_KEY_TOKEN   Cloudflare Realtime TURN, makes calls work behind strict networks
