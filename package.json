{
  "name": "yakyard",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted team chat on Cloudflare: channels, threads, DMs, calls, voice notes with transcripts.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/deploy.mjs",
    "db:init": "wrangler d1 execute yakyard --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute yakyard --local --file=schema.sql",
    "vapid": "node scripts/vapid.mjs",
    "test": "node --test test/merge-placeholder.test.mjs"
  },
  "dependencies": {
    "@pushforge/builder": "2.0.5"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
